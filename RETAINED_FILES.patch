-    def move(
-        self,
-        index: Union[int, list[int], tuple[int, ...]],
-        group: group.GroupLayer | None = None,
-    ) -> None:
-        """
-        Move one or more :class:`~arcgis.map.map_widget.MapContent` layers into
-        an existing :class:`~arcgis.map.group_layer.GroupLayer` or create a new
-        :class:`~arcgis.map.group_layer.GroupLayer` from the moved layers.
-
-        ==================      =====================================================================
-        **Parameter**           **Description**
-        ------------------      ---------------------------------------------------------------------
-        index                   Required int or sequence of ints. The index values of the layers
-                                you want to move.
-        ------------------      ---------------------------------------------------------------------
-        group                   Optional :class:`~arcgis.map.group_layer.GroupLayer` instance. The
-                                *group layer* you want to move the layer(s) indicated by *index* into.
-
-                                .. note::
-                                    If argument is *None*, a new :class:`~arcgis.map.group_layer.GroupLayer`
-                                    is created and the layers indicated by the *index* argument are moved
-                                    into it.
-        ==================      =====================================================================
-
-        .. code-block:: python
-
-            # Usage Example: Move map content layers into an existing group layer.
-
-            from arcgis.gis import GIS
-            from arcgis.map import Map
-
-            gis = GIS(profile="your_organization_profile")
-
-            wm_item = gis.content.search(
-                          query=f"title:{Water *} and owner:{gis.users.me.username}",
-                          item_type="Web Map"
-            )[0]
-
-            wm_obj = Map(item=wm_item)
-            map_content = wm_obj.content
-            map_content.layers
-
-            >>>
-               [GroupLayer(title=City Water Administration),
-                <FeatureLayer url:"https://services7.arcgis.com/<org_id>.../city_limit/FeatureServer/0">]
-
-            grp_lyr_1 = map_content.layers[0]
-            grp_lyr_1.layer_info
-
-            >>>
-                Layer Index	Layer Title	         Layer Type
-            0	   0	     main_line	           ArcGIS Feature Layer
-            1	   1	     service_lines	       ArcGIS Feature Layer
-            2      2         service_valves        ArcGIS Feature Layer
-
-            # Move the *Feature Layer* into the *GroupLayer*.
-            map_content.move(index=1, group=grp_lyr_1)
-
-            map_content.layers
-            >>>
-               [GroupLayer(title=City Water Administration)]
-
-            grp_lyr_1.layer_info
-            >>>
-                Layer Index	  Layer Title	         Layer Type
-            0	   0	        main_line	           ArcGIS Feature Layer
-            1	   1	        service_lines	       ArcGIS Feature Layer
-            2      2            service_valves         ArcGIS Feature Layer
-            3      3            city_limit             ArcGIS Feature Layer
-        """
-        if isinstance(index, int):
-            indexes = [index]
-        elif isinstance(index, (list, tuple)):
-            indexes = list(index)
-        else:
-            raise TypeError("`index` must be an int, list[int], or tuple[int, ...].")
-
-        if len(indexes) == 0:
-            raise ValueError("`index` must contain at least one layer index.")
-
-        if not all(isinstance(i, int) and not isinstance(i, bool) for i in indexes):
-            raise TypeError("All index values must be integers.")
-
-        if len(set(indexes)) != len(indexes):
-            raise ValueError("Duplicate indexes are not allowed.")
-
-        layer_count = len(self.layers)
-        out_of_range = [i for i in indexes if i < 0 or i >= layer_count]
-        if out_of_range:
-            raise IndexError(f"Layer index out of range: {out_of_range}")
-
-        indexes = sorted(indexes)
-
-        if group is not None and any(self.layers[i] is group for i in indexes):
-            raise ValueError("Cannot move a group layer into itself.")
-
-        # Capture layers in original order, then remove from highest index to lowest.
-        pydantic_layers_to_move = [
-            self._source._webmap.operational_layers[i] for i in indexes
-        ]
-        insert_index = indexes[0]
-
-        for i in reversed(indexes):
-            self.layers.pop(i)
-            self._source._webmap.operational_layers.pop(i)
-
-        if group is None:
-            # Create a new top-level GroupLayer at the first moved index.
-            new_group = _models_layers.GroupLayer(
-                layers=pydantic_layers_to_move,
-                title="Custom Group Layer",
-            )
-            self._source._webmap.operational_layers.insert(insert_index, new_group)
-        else:
-            target_children = group._group_layer.layers
-            if target_children is None:
-                group._group_layer.layers = []
-                target_children = group._group_layer.layers
-
-            for pydantic_layer in pydantic_layers_to_move:
-                target_children.append(pydantic_layer)
-
-        # Reset wrapper caches so subsequent reads reflect the updated pydantic tree.
-        self.clear_cache()
-        if group is not None:
-            group_layer_cache = getattr(group, "_layer_cache", None)
-            if hasattr(group_layer_cache, "clear"):
-                group_layer_cache.clear()
-
-        # Refresh the widget
-        self._source._update_source()
